# ==============================================================================
# ResolveAI Environment Configuration
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# Core App Settings
PROJECT_NAME="ResolveAI"
ENVIRONMENT="development"
DEBUG="true"

# Security (Generate a secure key with `openssl rand -hex 32`)
SECRET_KEY="resolveai-super-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Database Configuration
# Local SQLite default (Zero-dependency):
DATABASE_URL="sqlite:///./resolveai.db"
# Production PostgreSQL + pgvector:
# DATABASE_URL="postgresql+psycopg://resolveai:resolveai_secret_pwd@localhost:5432/resolveai_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# AI Provider Integration
# Choices: "mock" (default local deterministic simulation), "openai", "anthropic", "ollama"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"
EMBEDDING_MODEL_NAME="text-embedding-3-small"
SIMILARITY_THRESHOLD="0.72"

# Storage & Upload Limits
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_BYTES="15728640"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]'

# Production PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER="resolveai"
POSTGRES_PASSWORD="resolveai_secret_pwd"
POSTGRES_DB="resolveai_db"
